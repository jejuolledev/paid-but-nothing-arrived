# SQL door — Zetaris. Leave both empty to run the same queries on the synthetic CSVs via DuckDB.
ZETARIS_SQL_URL=
ZETARIS_API_KEY=
ZETARIS_SCHEMA=
# Model calls go only to Meterless Nightshift on this machine (OpenAI-compatible); where Nightshift routes them (local or a cloud lane) is set in Nightshift.
NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
NIGHTSHIFT_API_KEY=rt-local
LLM_MODEL=nvidia/nemotron-3.5-lightning
# Optional cloud fallback for the demo (synthetic data only)
OPENROUTER_API_KEY=
# Local Zetaris platform (docker compose) — official JDBC path
ZETARIS_JDBC_URL=jdbc:zetaris:lightning@localhost:10000
ZETARIS_JDBC_JAR=../zetaris-platform/jdbc/ndp-jdbc-driver-2.4.3.1-7eff043-driver.jar
ZETARIS_USER=admin@zetaris.com
ZETARIS_PASSWORD=
JAVA_HOME=/opt/homebrew/opt/openjdk@21
